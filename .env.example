# Somente valores ilustrativos. Copie para .env e escolha sua senha local.
POSTGRES_DB=local_services
POSTGRES_USER=local_services
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_PORT=5433

# O processo Java não carrega este arquivo automaticamente.
# Configure no IntelliJ/terminal: DB_PASSWORD, JWT_SECRET (Base64 aleatório >= 32 bytes).
# Opcionais: DB_URL, DB_USER, JWT_COOKIE_SECURE=true quando usar HTTPS.
